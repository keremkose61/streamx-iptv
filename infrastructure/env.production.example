# ==============================================================================
# StreamX IPTV - Production Environment Configuration
# ==============================================================================

APP_NAME="StreamX IPTV"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://iptv.streamx.tv

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (MySQL 8.4)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=streamx_db
DB_USERNAME=streamx_user
DB_PASSWORD=YOUR_STRONG_PRODUCTION_DB_PASSWORD

# Session & Cache (Redis 7)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=streamx_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum Token Lifetime (in minutes, e.g. 30 days)
SANCTUM_EXPIRATION=43200

# Payment Gateways (Stripe, Iyzico, or Mock)
PAYMENT_GATEWAY=mock
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@streamx.tv"
MAIL_FROM_NAME="${APP_NAME}"
